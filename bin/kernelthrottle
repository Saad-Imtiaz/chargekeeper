#!/usr/bin/python3 -I
import os
import sys

for base in ("/usr/lib/kernelthrottle", os.path.dirname(os.path.dirname(os.path.realpath(__file__)))):
    if os.path.isdir(os.path.join(base, "kernelthrottle")):
        sys.path.insert(0, base)
        break

from kernelthrottle import cli  # noqa: E402

args = sys.argv[1:]
if (args and args[0] in cli.COMMANDS) or (not args and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))):
    sys.exit(cli.main(args))

from kernelthrottle import gui  # noqa: E402

sys.exit(gui.main(sys.argv))
