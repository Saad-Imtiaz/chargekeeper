#!/usr/bin/python3 -I
import os
import sys

for base in ("/usr/lib/powerkeeper", os.path.dirname(os.path.dirname(os.path.realpath(__file__)))):
    if os.path.isdir(os.path.join(base, "powerkeeper")):
        sys.path.insert(0, base)
        break

from powerkeeper import helper  # noqa: E402

helper.main()
