// Administrators at the local, active seat change battery settings without a
// password. Everyone else is asked for an administrator password (see the policy).
polkit.addRule(function (action, subject) {
    if (action.id == "dev.kernelthrottle.KernelThrottle.helper" && subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("wheel") || subject.isInGroup("admin"))) {
        return polkit.Result.YES;
    }
});
