[Unit]
Description=Powerkeeper battery charge limit service
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/lib/powerkeeper/powerkeeper-helper daemon
# If the service stops or crashes, never leave charging paused with nobody to resume it.
ExecStopPost=/usr/lib/powerkeeper/powerkeeper-helper release
Restart=on-failure
RestartSec=5
RuntimeDirectory=powerkeeper
RuntimeDirectoryPreserve=yes
StateDirectory=powerkeeper
ConfigurationDirectory=powerkeeper
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
