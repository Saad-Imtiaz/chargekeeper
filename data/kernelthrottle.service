[Unit]
Description=KernelThrottle battery charge limit service
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/lib/kernelthrottle/kernelthrottle-helper daemon
# If the service stops or crashes, never leave charging paused with nobody to resume it.
ExecStopPost=/usr/lib/kernelthrottle/kernelthrottle-helper release
Restart=on-failure
RestartSec=5
RuntimeDirectory=kernelthrottle
RuntimeDirectoryPreserve=yes
StateDirectory=kernelthrottle
ConfigurationDirectory=kernelthrottle
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
